# Copy this file to .env in the root of the consuming Unreal project.
# UnrealAI reads the project-root .env file when it resolves a provider profile.
# Never commit the copied .env file or real API keys.

# OpenAI provider
OPENAI_API_KEY=

# xAI provider
XAI_API_KEY=

# Optional overrides used by the built-in provider profiles.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6-luna

# Additional provider profiles may use their own API-key environment variable.
# Configure its name under Project Settings -> Plugins -> UnrealAI.
