# Copy this file to .env in the root of the consuming Unreal project.
# UnrealAI reads the project-root .env file when it resolves a provider profile.
# Never commit the copied .env file or real API keys.

# OpenAI provider
OPENAI_API_KEY=

# xAI provider
XAI_API_KEY=

# Anthropic provider
ANTHROPIC_API_KEY=

# Google Gemini provider
GEMINI_API_KEY=

# Optional overrides used by the built-in provider profiles.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6-luna
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.6
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-3.7-flash

# Legacy compatibility: the XAI profile falls back to OPENAI_BASE_URL and
# OPENAI_MODEL when the corresponding XAI override is unset.
